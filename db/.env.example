# Copia este archivo como db/.env y rellena con las claves del proyecto Supabase de GalapaGo (España).
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_KEY=<service_role key, empieza por eyJ>
# Supabase → botón "Connect" → Session pooler (puerto 5432)
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
